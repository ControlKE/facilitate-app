PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=facilitate

# Optional:
# Set true to run OCR with tesseract.js for images/scanned PDFs.
AUDIT_OCR_ENABLED=false

# Max upload size in bytes (default 20MB)
AUDIT_MAX_UPLOAD_BYTES=20971520

# Max extracted text chars persisted in DB
AUDIT_MAX_TEXT_STORE=200000
